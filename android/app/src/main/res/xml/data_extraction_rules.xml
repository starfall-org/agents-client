<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- No automatic cloud backup or device transfer of encrypted SSH keys,
         WebSocket headers, provider credentials, or local session metadata. -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
